# Copy to .env and fill in your own Supabase project values.
# Never commit a real key — .env is gitignored.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FoodX vendor registry (Phase 8 step 2 + landing/onboarding step 2).
# The registry URL + its anon key are public values from the vendor's
# deploy template: set these two on every client deployment so the
# panel can activate with a license key (Settings → License, or the
# first-run setup wizard) and validate the license by heartbeat.
VITE_FOODX_REGISTRY_URL=
VITE_FOODX_REGISTRY_ANON_KEY=
# Optional — manual provisioning fallback. When the vendor issues an
# instance token in the Developer Panel instead of using in-panel
# activation, set this deployment's client code + token here. An
# in-panel activation (instance_config table) takes precedence.
VITE_FOODX_INSTANCE_ID=
VITE_FOODX_INSTANCE_TOKEN=
