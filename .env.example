# Copy to .env and fill in your own Supabase project values.
# Never commit a real key — .env is gitignored.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — FoodX vendor heartbeat (Phase 8 step 2). Leave unset to
# disable. Values come from the Developer Panel when a client is set up:
# the registry project URL + its anon key, this deployment's client code
# and its one-time instance token.
VITE_FOODX_REGISTRY_URL=
VITE_FOODX_REGISTRY_ANON_KEY=
VITE_FOODX_INSTANCE_ID=
VITE_FOODX_INSTANCE_TOKEN=
